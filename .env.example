# ---------------------------------------------------------------------------
# Exemplo de variaveis de ambiente para rodar a Sophia.
# Copie este arquivo para ".env" e preencha com as suas credenciais da AWS.
# O arquivo ".env" NAO e versionado (veja o .gitignore).
#
# Importante: as credenciais sao lidas SOMENTE do ambiente; nenhuma chave e
# escrita no codigo. O boto3 resolve estas variaveis automaticamente.
# ---------------------------------------------------------------------------

# Credenciais da AWS com acesso ao Amazon Bedrock (bedrock-runtime).
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui

# Opcional: necessario apenas se voce usar credenciais temporarias (STS).
# AWS_SESSION_TOKEN=seu_session_token_aqui

# Regiao onde o modelo esta disponivel para este projeto.
AWS_DEFAULT_REGION=us-east-1
